# Canonical Apple toolchain contract for AssetPipeline.
# Simple KEY=value entries, like config/android_toolchain.env, so shell tooling
# and generators share one source of truth.
#
# The iOS cross-compile needs the AgentC Crystal fork: stock Crystal 1.21.0 has
# no C bindings for the arm64-apple-ios targets (its standard library falls to
# the ELF loader path and fails on c/fcntl). The fork ships as a Homebrew tap
# formula built from source; the Apple lane caches the built keg by this pin.
CRYSTAL_FORK_TAP=crimson-knight/agent-crystal
CRYSTAL_FORK_FORMULA=agent-crystal
CRYSTAL_FORK_VERSION=1.21.0-incremental-1
CRYSTAL_FORK_COMMAND=acrystal
# Runner images the Apple lane runs on: the shipping Xcode and the preview.
APPLE_RUNNER_CURRENT=macos-26
APPLE_RUNNER_PREVIEW=xcode-27
# Floors, restated from their owners for the support matrix:
#   iOS deployment target: samples/cross_platform/ios_host/project.yml
#   SwiftKit platforms: swift/AssetPipelineSwiftKit/Package.swift
